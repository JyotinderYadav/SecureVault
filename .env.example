# SecureVault Environment Configuration Example
# Copy to .env for custom deployment settings

# Server Host & Ports
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501

# System Security Mode: VULNERABLE or HARDENED
SECURITY_MODE=VULNERABLE

# Authentication & Cryptography
JWT_SECRET=securevault-cs473-secret-key-2026
JWT_ALGORITHM=HS256

# Storage Settings
STORAGE_DIR=app/storage/uploads
VAULT_STORAGE=app/storage
